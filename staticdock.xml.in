<?xml version="1.0" encoding="UTF-8"?>
<compiz>
    <plugin name="staticdock" useBcop="true">
        <_short>Static Dock</_short>
        <_long>Keep panels and docks flat while the desktop cube/rotate plugins transform the screen</_long>
        <category>Desktop</category>
        <deps>
            <relation type="after">
                <plugin>cube</plugin>
                <plugin>rotate</plugin>
                <plugin>expo</plugin>
                <plugin>zoom</plugin>
                <plugin>ezoom</plugin>
            </relation>
            <requirement>
                <plugin>composite</plugin>
                <plugin>opengl</plugin>
            </requirement>
        </deps>
        <options>
            <group>
                <short>Behaviour</short>
                
                <option name="cube_static_docks" type="bool">
                    <short>Enable for Cube Rotation/Transformation</short>
                    <default>true</default>
                </option>
                <option name="expo_static_docks" type="bool">
                    <short>Enable for Expo</short>
                    <default>true</default>
                </option>
            </group>
        </options>
    </plugin>
</compiz>
